{
  "name": "@herox/server",
  "version": "0.1.0",
  "private": true,
  "description": "API và phục vụ tĩnh của HeroX",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@herox/shared": "0.1.0",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
