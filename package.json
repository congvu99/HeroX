{
  "name": "herox",
  "version": "0.1.0",
  "private": true,
  "description": "HeroX — game nhập vai học từ, đọc tiến độ từ LingoBrain",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,client \"npm run dev -w @herox/server\" \"npm run dev -w @herox/client\"",
    "build": "npm run build -w @herox/shared && npm run build -w @herox/server && npm run build -w @herox/client",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "pixelfx": "github:patch-gg/pixelfx#044e12a45dc9cc312cec50ee606dfc98afe5adc2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
