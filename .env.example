# Chuỗi kết nối Postgres dùng chung với LingoBrain, đăng nhập bằng role herox_app (bắt buộc).
DATABASE_URL=postgres://herox_app:CHANGE_ME@localhost:5432/lingobrain
# Cổng HTTP của server HeroX (dev cố định 3180).
PORT=3180
# Số proxy tin cậy đứng trước server: 0 khi chạy trực tiếp, 1 khi sau reverse proxy.
TRUST_PROXY_HOPS=0
# Bật TLS khi kết nối Postgres: true | false. Khi bật, chứng chỉ server luôn được xác thực.
PGSSL=false
# File CA để xác thực chứng chỉ Postgres (tuỳ chọn); trống thì dùng CA hệ thống.
PGSSLROOTCERT=
