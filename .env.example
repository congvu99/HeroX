# Chuỗi kết nối Postgres dùng chung với LingoBrain, đăng nhập bằng role herox_app.
# Phase 01 chưa kết nối DB; giá trị này bắt buộc từ phase 02.
DATABASE_URL=postgres://herox_app:CHANGE_ME@localhost:5432/lingobrain
# Cổng HTTP của server HeroX (dev cố định 3180).
PORT=3180
# Số proxy tin cậy đứng trước server: 0 khi chạy trực tiếp, 1 khi sau reverse proxy.
TRUST_PROXY_HOPS=0
# Bật TLS khi kết nối Postgres: true | false.
PGSSL=false
